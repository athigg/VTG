# Copy values into your shell environment for local development.
APP_ENV=development
ADDR=:8080
DATABASE_PATH=data/vtg-store.db
UPLOAD_DIR=static/uploads

# The app supplies local-only fallback keys. Set independent random keys in production.
SESSION_KEY=
CSRF_KEY=

# Optional demo-admin overrides; used only for the first development seed.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=